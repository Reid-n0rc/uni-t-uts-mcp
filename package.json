{
  "name": "uni-t-uts-mcp",
  "version": "0.0.0",
  "description": "MCP server for UNI-T UTS series spectrum analyzers via SCPI over LAN",
  "author": "Reid Crowe <reid@malmoset.com>",
  "license": "MIT",
  "homepage": "https://reid-n0rc.github.io/uni-t-uts-mcp/",
  "bugs": {
    "url": "https://github.com/Reid-n0rc/uni-t-uts-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Reid-n0rc/uni-t-uts-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "uni-t",
    "uts",
    "uts3000b",
    "uts1000b",
    "spectrum-analyzer",
    "scpi",
    "test-equipment",
    "instrument",
    "rf"
  ],
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "uni-t-uts-mcp": "build/index.js"
  },
  "files": [
    "build/**/*.js",
    "build/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node build/index.js",
    "dev": "tsc && node build/index.js",
    "inspector": "npx @modelcontextprotocol/inspector node build/index.js",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.test.json",
    "site": "npm run build && node scripts/build-site.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
